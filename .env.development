# Development Environment Configuration
APP_ENV=development
PORT=8000
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://localhost:5174"]

# Database
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=school_alumni_db

# JWT Auth
JWT_SECRET=justgathernow-super-secret-key-32-chars-minimum-length-2026
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=30

# Azure Blob Storage (Optional in dev - local fallback used if empty)
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER=alumni-memories

# Firebase Push Notifications
FIREBASE_PROJECT_ID=abc-school-alumni
