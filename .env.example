# Application Settings
APP_NAME="School Alumni & Batch Get-Together Platform"
APP_ENV=development
PORT=8000
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://localhost:5174"]

# Database Settings
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=school_alumni_db

# JWT & Auth Settings
JWT_SECRET=your_jwt_secret_key_minimum_32_characters_here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=30
DEFAULT_DEV_OTP=123456

# Azure Storage Settings
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER=alumni-memories
AZURE_CDN_URL=

# Firebase Settings
FIREBASE_PROJECT_ID=

# Google OAuth Settings
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback
FRONTEND_URL=http://localhost:5173

# Primary Developer & Platform Configuration
INITIAL_SCHOOL_NAME="NHS SCHOOL"
INITIAL_SCHOOL_CODE="NHSS"
INITIAL_ADMIN_MOBILE="+917550375037"

# SMTP Email Configuration (Preserved for system & notification emails)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAILS_FROM_NAME="NHSS Alumni Association"
EMAILS_FROM_EMAIL=

# 2Factor SMS Configuration (SMS OTP ONLY — NO VOICE CALLS)
TWO_FACTOR_API_KEY=your_2factor_api_key_here
TWO_FACTOR_TEMPLATE="NHSS Alumni"
TWO_FACTOR_SENDER_ID=SMSNHS

